        local function closest_part(plr)
            local mp = Vector2.new(mouse.X, mouse.Y)
            local closest, cp = math.huge, nil
            for _, v in next, plr.Character:GetChildren() do
                if v:IsA("BasePart") then
                    local pos, on = camera:WorldToViewportPoint(v.Position)
                    if on then
                        local d = (mp - Vector2.new(pos.X, pos.Y)).Magnitude
                        if d <= closest then closest, cp = d, v end
                    end
                end
            end
            return cp
        end

        local function GetMuzzlePos()
            local vp = camera.ViewportSize
            local fallback = Vector2.new(vp.X / 2, vp.Y / 2)
            local first_person = workspace:FindFirstChild("ViewModels") and workspace.ViewModels:FindFirstChild("FirstPerson")
            if not first_person then return fallback end
            for _, P in first_person:GetDescendants() do
                if P.Name == "_muzzle" and P:IsA("Attachment") then
                    local Pos = camera:WorldToViewportPoint(P.WorldPosition)
                    return Vector2.new(Pos.X, Pos.Y)
                end
            end
            return fallback
        end

        local function getclosest()
            local closest = ELI.targeting.max_distance
            local player
            local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
            for _, v in Players:GetPlayers() do
                if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild(ELI.targeting.part) and v.Character.Humanoid.Health > 0 then
                    if is_deflecting(v) then continue end
                    if v:GetAttribute('TeamID') == LocalPlayer:GetAttribute('TeamID') then continue end
                    if ELI.targeting.visible_only and not check_wall(v.Character[ELI.targeting.part]) then continue end
                    if ELI.targeting.riot_shield and has_riot(v) then continue end
                    local pos, on = camera:WorldToViewportPoint(v.Character[ELI.targeting.part].Position)
                    if on then
                        local d = (center - Vector2.new(pos.X, pos.Y)).Magnitude
                        if d < closest and d <= ELI.silent_aim.fov_radius then
                            player = v; closest = d
                        end
                    end
                end
            end
            return player
        end

