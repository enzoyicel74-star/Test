        local Trove = (function()
            local T = {}
            T.__index = T
            function T.new() return setmetatable({ _objects = {} }, T) end
            function T:Add(object) self._objects[#self._objects + 1] = object; return object end
            function T:Destroy()
                local objects = self._objects
                self._objects = {}
                for i = #objects, 1, -1 do
                    local object = objects[i]
                    local ot = typeof(object)
                    pcall(function()
                        if ot == 'RBXScriptConnection' then object:Disconnect()
                        elseif ot == 'Instance' then object:Destroy()
                        elseif ot == 'thread' then task.cancel(object)
                        elseif ot == 'function' then object()
                        elseif ot == 'table' then
                            if object.Destroy then object:Destroy()
                            elseif object.Disconnect then object:Disconnect() end
                        end
                    end)
                end
            end
