                if c.text.studs then c.text.studs:Destroy() end
                if c.text.tool then c.text.tool:Destroy() end
            end
            if c.bars and c.bars.hp then
                if c.bars.hp.bg then c.bars.hp.bg:Destroy() end
                if c.bars.hp.fill then c.bars.hp.fill:Destroy() end
            end
            if c.highlight then pcall(function() c.highlight:Destroy() end) end
            esp_cache[player] = nil
        end

        local function esp_hide(player)
            if not esp_cache[player] then return end
            local c = esp_cache[player]
            if c.box then
                if c.box.filled then c.box.filled.Visible = false end
                if c.box.square and hasDrawing then c.box.square.Visible = false end
                if c.box.outline and hasDrawing then c.box.outline.Visible = false end
                if c.box.inline and hasDrawing then c.box.inline.Visible = false end
            end
            if c.text then
                if c.text.name then c.text.name.Visible = false end
                if c.text.studs then c.text.studs.Visible = false end
                if c.text.tool then c.text.tool.Visible = false end
            end
            if c.bars and c.bars.hp then
                if c.bars.hp.bg then c.bars.hp.bg.Visible = false end
                if c.bars.hp.fill then c.bars.hp.fill.Visible = false end
            end
            if c.highlight and c.highlight.Enabled then c.highlight.Enabled = false end
        end

        local esp_vis_check = {}
        local function esp_update(player)
            if not esp_cache[player] then return end
            local character = player.Character
            if not character or not character.Parent then esp_hide(player) return end
            local root = character:FindFirstChild("HumanoidRootPart")
            local hum  = character:FindFirstChildWhichIsA("Humanoid")
            if not root or not hum then esp_hide(player) return end
            if hum.Health <= 0 then esp_hide(player) return end

            local cfg = ELI.esp
            if cfg.team_check and player:GetAttribute("TeamID") ~= nil
                and player:GetAttribute("TeamID") == LocalPlayer:GetAttribute("TeamID") then
                esp_hide(player) return
            end

            local rootpos = root.Position
            local camcf   = camera.CFrame.Position
            local dist    = (camcf - rootpos).Magnitude
            if dist > cfg.max_dist then esp_hide(player) return end
            local _, onscreen = camera:WorldToViewportPoint(rootpos)
            if not onscreen then esp_hide(player) return end

            local left, top, w, h = esp_getbounds(root, dist)
            if not left then esp_hide(player) return end

            local c        = esp_cache[player]
            local cbox     = c.box
            local ctext    = c.text
            local chp      = c.bars.hp

            local espVisible = false
            if cfg.visible.enable then
                local last = esp_vis_check[player] or 0
                if (tick() - last) >= 0.15 then
                    local ok, seen = pcall(check_wall, root)
                    c.vis = ok and seen == true
                    esp_vis_check[player] = tick()
                end
                espVisible = c.vis == true
            end

            local cfgfill  = cfg.filled
            local cfgbox   = cfg.box
            local cfghp    = cfg.health
            local cfgtxt   = cfg.text

            if cfgfill.enable then
                local fb = cbox.filled
                fb.Visible = true
                fb.BackgroundTransparency = cfgfill.transparency
                fb.Position = udim2offset(left, top)
                fb.Size = udim2offset(w, h)
                fb.BackgroundColor3 = espVisible and cfg.visible.color or cfgfill.color_start
            else
                cbox.filled.Visible = false
            end

            if cfg.highlight.enable and c.highlight then
                local hl = c.highlight
                if hl.Adornee ~= character then hl.Adornee = character end
                hl.FillColor = espVisible and cfg.visible.color or cfg.highlight.fill_color
                hl.OutlineColor = cfg.highlight.outline_color
                hl.FillTransparency = cfg.highlight.fill_transparency
                hl.OutlineTransparency = cfg.highlight.outline_transparency
                if not hl.Enabled then hl.Enabled = true end
            elseif c.highlight and c.highlight.Enabled then
                c.highlight.Enabled = false
            end

            if cfgbox.enable and hasDrawing then
                local sq, ol, il = cbox.square, cbox.outline, cbox.inline
                ol.Visible = true; ol.Color = cfgbox.outline
                ol.Position = v2new(left - 1, top - 1); ol.Size = v2new(w + 2, h + 2)
                sq.Visible = true; sq.Color = espVisible and cfg.visible.color or cfgbox.color
                sq.Thickness = cfgbox.thickness
                sq.Position = v2new(left, top); sq.Size = v2new(w, h)
                il.Visible = true; il.Color = cfgbox.inline
                il.Position = v2new(left + 1, top + 1); il.Size = v2new(w - 2, h - 2)
            else
                if cbox.outline then cbox.outline.Visible = false end
                if cbox.square then cbox.square.Visible = false end
                if cbox.inline then cbox.inline.Visible = false end
            end

            if cfghp.enable then
                local hptarget = mclamp(hum.Health / mmax(hum.MaxHealth, 1), 0, 1)
                local hplerp = chp.lasthp + (hptarget - chp.lasthp) * 0.15
                if math.abs(hplerp - chp.lasthp) > 0.001 then chp.lasthp = hplerp end
                local fillh = mceil(h * chp.lasthp)
                local barx = left - cfghp.width - cfghp.gap
                chp.bg.Visible = true
                chp.bg.Position = udim2offset(barx, top)
                chp.bg.Size = udim2offset(cfghp.width, h)
                chp.fill.Visible = true
                chp.fill.Position = udim2offset(barx, top + h - fillh)
                chp.fill.Size = udim2offset(cfghp.width, fillh)
                local pct = chp.lasthp
                chp.fill.BackgroundColor3 = pct > 0.5 and Color3.fromRGB(50,255,50) or pct > 0.25 and Color3.fromRGB(255,200,50) or Color3.fromRGB(255,50,50)
            else
                chp.bg.Visible = false
                chp.fill.Visible = false
            end

            local txtsize = cfgtxt.size
            local lname = ctext.name
            lname.Visible = cfgtxt.name.enable
            lname.Text = player.Name
            lname.TextColor3 = cfgtxt.name.color
            lname.TextSize = txtsize
            lname.Position = udim2offset(left, top - 13)
            lname.Size = udim2offset(w, 12)

            local distm = mfloor(dist * 0.28)
            if distm ~= chp.lastdist then
                chp.lastdist = distm
                chp.lastdiststr = sfmt("%dM", distm)
            end
            local lstuds = ctext.studs
            lstuds.Visible = cfgtxt.studs.enable
            lstuds.Text = chp.lastdiststr
            lstuds.TextColor3 = cfgtxt.studs.color
            lstuds.TextSize = txtsize
            lstuds.Position = udim2offset(left, top + h + 2)
            lstuds.Size = udim2offset(w, 12)

            local ltool = ctext.tool
            if cfgtxt.tool.enable then
                ltool.Visible = true
                ltool.Text = esp_getweapon(player)
                ltool.TextColor3 = cfgtxt.tool.color
                ltool.TextSize = txtsize
                ltool.TextXAlignment = alignleft
                ltool.Position = udim2offset(left + w + cfghp.width + cfghp.gap + 2, top)
                ltool.Size = udim2offset(50, 12)
            else
                ltool.Visible = false
            end
        end

