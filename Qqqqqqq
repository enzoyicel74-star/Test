local aaAngAcc = 0; local aaJitter = 0; local aaRandTimer = 0; local aaRandMult = 1
local aaMicroTimer = 0; local aaRollAcc = 0; local aaBreatheAcc = 0
local aaChaosTimer = 0; local aaLookAtTimer = 0
local aaMultiX, aaMultiY, aaMultiZ = 0, 0, 0

function startAntiAim()
    killConn("antiAim")
    conns.antiAim = RunService.Heartbeat:Connect(function(dt)
        if not antiAim.enabled then killConn("antiAim"); return end
        if not root then return end
        if antiAim.aaNoClip and LocalPlayer.Character then applyNoClip(LocalPlayer.Character) end
        if antiAim.aaNetworkOwn then setNetworkOwnerLocal(root) end
        aaMicroTimer = aaMicroTimer + dt; aaBreatheAcc = aaBreatheAcc + dt
        aaRollAcc = aaRollAcc + dt; aaChaosTimer = aaChaosTimer + dt
        aaLookAtTimer = aaLookAtTimer + dt
        local spd = antiAim.speed
        if antiAim.randomSpeed then
            aaRandTimer = aaRandTimer + dt
            if aaRandTimer > 0.1 then aaRandTimer = 0; aaRandMult = 0.2 + math.random() * 0.8 end
            spd = spd * aaRandMult
        end
        local extraYaw = 0; local extraPitch = 0; local extraRoll = 0
        if antiAim.fakeAngle then extraYaw = extraYaw + antiAim.fakeYaw; extraPitch = extraPitch + antiAim.fakePitch end
        if antiAim.breatheEffect then extraPitch = extraPitch + math.sin(aaBreatheAcc * antiAim.breatheSpeed * 2 * math.pi) * antiAim.breatheAmp end
        if antiAim.microJitter and aaMicroTimer >= (1 / math.max(antiAim.microJitterSpeed, 1)) then
            aaMicroTimer = 0
            extraYaw = extraYaw + (math.random() - 0.5) * antiAim.microJitterAmp * 2
            extraPitch = extraPitch + (math.random() - 0.5) * antiAim.microJitterAmp
        end
        if antiAim.desyncMode then extraYaw = extraYaw + antiAim.desyncOffset end
        if antiAim.randomFlip and math.random() < antiAim.flipChance then extraYaw = extraYaw + 180 end
        if antiAim.enhancedMode then
            extraYaw = extraYaw + (math.random() - 0.5) * antiAim.enhancedJitterAmp * 2
            extraPitch = extraPitch + (math.random() - 0.5) * antiAim.enhancedJitterAmp
            if antiAim.chaosMode and aaChaosTimer >= antiAim.chaosInterval then
                aaChaosTimer = 0
                extraYaw = extraYaw + (math.random() - 0.5) * antiAim.chaosMaxAngle * 2
                extraPitch = extraPitch + (math.random() - 0.5) * antiAim.chaosMaxAngle
                extraRoll = extraRoll + (math.random() - 0.5) * antiAim.chaosMaxAngle
            end
            if antiAim.multiAxisSpin then
                if antiAim.multiAxisX then aaMultiX = aaMultiX + antiAim.multiAxisSpeedX * dt end
                if antiAim.multiAxisY then aaMultiY = aaMultiY + antiAim.multiAxisSpeedY * dt end
                if antiAim.multiAxisZ then aaMultiZ = aaMultiZ + antiAim.multiAxisSpeedZ * dt end
            end
            if antiAim.lookAtRandom and aaLookAtTimer >= antiAim.lookAtRandomInterval then
                aaLookAtTimer = 0
                extraYaw = extraYaw + math.random() * 360
                extraPitch = extraPitch + (math.random() - 0.5) * 180
            end
        end
        local rollAngle = 0
        if antiAim.rollEnabled then rollAngle = (aaRollAcc * antiAim.rollSpeed * math.pi / 180) % (2 * math.pi) end
        if antiAim.mode == "Spin" then
            aaAngAcc = aaAngAcc + spd * dt
            root.CFrame = CFrame.new(root.Position) * CFrame.Angles(math.rad(extraPitch), math.rad(aaAngAcc + extraYaw), rollAngle + extraRoll)
        elseif antiAim.mode == "Jitter" then
            local p = antiAim.jitterPitch and antiAim.pitchAngle or 0
            local y = antiAim.jitterYaw and antiAim.yawAngle or 0
            root.CFrame = root.CFrame * CFrame.Angles(math.rad((aaJitter == 0 and p or -p) + extraPitch), math.rad((aaJitter == 0 and y or -y) + extraYaw), rollAngle + extraRoll)
            aaJitter = (aaJitter + 1) % 2
        elseif antiAim.mode == "Static" then
            root.CFrame = CFrame.new(root.Position) * CFrame.Angles(math.rad(antiAim.staticPitch + extraPitch), math.rad(antiAim.staticYaw + extraYaw), rollAngle + extraRoll)
        elseif antiAim.mode == "Up" then
            root.CFrame = CFrame.new(root.Position) * CFrame.Angles(math.rad(90 + extraPitch), math.rad(extraYaw), rollAngle + extraRoll)
        elseif antiAim.mode == "Down" then
            root.CFrame = CFrame.new(root.Position) * CFrame.Angles(math.rad(-90 + extraPitch), math.rad(extraYaw), rollAngle + extraRoll)
        elseif antiAim.mode == "Side" then
            root.CFrame = CFrame.new(root.Position) * CFrame.Angles(math.rad(extraPitch), math.rad(extraYaw), math.rad(90) + rollAngle + extraRoll)
        elseif antiAim.mode == "RandomSpin" then
            aaAngAcc = aaAngAcc + spd * dt * (math.random() * 2 - 1)
            root.CFrame = CFrame.new(root.Position) * CFrame.Angles(math.rad(antiAim.customPitch + extraPitch), math.rad(aaAngAcc + extraYaw), rollAngle + extraRoll)
        elseif antiAim.mode == "Custom" then
            root.CFrame = CFrame.new(root.Position) * CFrame.Angles(math.rad(antiAim.customPitch + extraPitch), math.rad(antiAim.customYaw + extraYaw), rollAngle + extraRoll)
        end
        if antiAim.enhancedMode and antiAim.multiAxisSpin then
            root.CFrame = root.CFrame * CFrame.Angles(math.rad(aaMultiX), math.rad(aaMultiY), math.rad(aaMultiZ))
        end
    end)
end
function stopAntiAim() killConn("antiAim"); antiAim.enabled = false end

local riotGMTimer = 0; local riotGMAng = 0; local riotGMConn = nil
local riotGMLastShot = 0

function startRiotGodmode()
    if riotGMConn then riotGMConn:Disconnect() end
    riotGMTimer = 0; riotGMAng = 0; riotGMLastShot = 0
    riotGMConn = RunService.Heartbeat:Connect(function(dt)
        if not riotGod.enabled then stopRiotGodmode(); return end
        local hrp = getLocalRoot()
        if not hrp then return end
        if riotGod.rgNoClip and LocalPlayer.Character then applyNoClip(LocalPlayer.Character) end
        if riotGod.rgNetworkOwn then setNetworkOwnerLocal(hrp) end
        riotGMTimer = riotGMTimer + dt
        if riotGMTimer < riotGod.speed then return end
        riotGMTimer = 0
        local cur = hrp.Position
        local target = getClosest()
        local tHrp = nil
        local newPos = cur
        local function pickPos(from)
            local a = math.random() * 2 * math.pi
            local d = riotGod.minJump + math.random() * (riotGod.maxJump - riotGod.minJump)
            return from + Vector3.new(math.cos(a) * d, math.random(-riotGod.heightVariance, riotGod.heightVariance), math.sin(a) * d)
        end
        if target and target.Character then
            tHrp = target.Character:FindFirstChild("HumanoidRootPart")
            if tHrp then
                if riotGod.avoidBullets and (cur - tHrp.Position).Magnitude < riotGod.evadeRange then
                    local dir = (cur - tHrp.Position).Unit
                    newPos = cur + dir * riotGod.bulletDodge
                else newPos = pickPos(cur) end
            else newPos = pickPos(cur) end
        else newPos = pickPos(cur) end
        if riotGod.groundSnap then newPos = Vector3.new(newPos.X, cur.Y, newPos.Z) end
        riotGMAng = (riotGMAng + riotGod.spinSpeed * dt) % 360
        local ax = riotGod.randomAxis and math.random(1, 3) or (riotGod.spinAxis == "X" and 1 or riotGod.spinAxis == "Y" and 2 or 3)
        local cf = CFrame.new(newPos)
        if ax == 1 then cf = cf * CFrame.Angles(math.rad(riotGMAng), 0, 0)
        elseif ax == 2 then cf = cf * CFrame.Angles(0, math.rad(riotGMAng), 0)
        else cf = cf * CFrame.Angles(0, 0, math.rad(riotGMAng)) end
        if riotGod.phaseMode then
            local acc2 = 0
            while acc2 < riotGod.speed do
                pcall(function() hrp.CFrame = cf; if riotGod.rgVelZero then hrp.AssemblyLinearVelocity = Vector3.zero end end)
                task.wait(riotGod.phaseInterval); acc2 = acc2 + riotGod.phaseInterval
            end
        else
            pcall(function() hrp.CFrame = cf; if riotGod.rgVelZero then hrp.AssemblyLinearVelocity = Vector3.zero; hrp.AssemblyAngularVelocity = Vector3.zero end end)
        end
        if riotGod.autoShoot and tHrp and target then
            local now = tick()
            if (hrp.Position - tHrp.Position).Magnitude < riotGod.attackRange and now - riotGMLastShot > riotGod.shootCooldown then
                riotGMLastShot = now
                if riotGod.rgAutoShootAccurate then aimAtTarget(hrp, tHrp.Position) end
                fireTool()
            end
        end
    end)
end
function stopRiotGodmode()
    if riotGMConn then riotGMConn:Disconnect(); riotGMConn = nil end
    riotGod.enabled = false
end

local riotAbuserConn = nil; local riotAbuserOrbAng = 0

function startRiotAbuser()
    if riotAbuserConn then riotAbuserConn:Disconnect() end
    riotAbuserOrbAng = 0
    riotAbuserConn = RunService.Heartbeat:Connect(function(dt)
        if not riotAbuse.enabled then stopRiotAbuser(); return end
        local hrp = getLocalRoot()
        if not hrp then return end
        if riotAbuse.raNoClip and LocalPlayer.Character then applyNoClip(LocalPlayer.Character) end
        if riotAbuse.raNetworkOwn then setNetworkOwnerLocal(hrp) end
        local target = riotAbuse.multiTarget and getTarget("Random") or getClosest()
        if not target or not target.Character then return end
        local tHrp = target.Character:FindFirstChild("HumanoidRootPart")
        if not tHrp then return end
        local cf = tHrp.CFrame
        local tPos = riotAbuse.predictTarget and predictPos(tHrp, riotAbuse.predictLead) or tHrp.Position
        local rOff = riotAbuse.randomOffset
            and Vector3.new((math.random()-0.5)*riotAbuse.randomOffAmp*2, 0, (math.random()-0.5)*riotAbuse.randomOffAmp*2)
            or Vector3.zero
        if riotAbuse.mode == "Stick" then
            hrp.CFrame = CFrame.new(tPos + cf.RightVector*riotAbuse.right + cf.UpVector*(riotAbuse.height-riotAbuse.down) + cf.LookVector*riotAbuse.forward + rOff)
        elseif riotAbuse.mode == "Bounce" then
            local bounce = math.abs(math.sin(tick()*riotAbuse.bounceSpeed)) * riotAbuse.bounceHeight
            hrp.CFrame = CFrame.new(tPos + cf.RightVector*riotAbuse.right + cf.UpVector*(bounce-riotAbuse.down) + cf.LookVector*riotAbuse.forward + rOff)
        elseif riotAbuse.mode == "Orbit" then
            riotAbuserOrbAng = (riotAbuserOrbAng + math.rad(riotAbuse.orbitSpeed)*dt) % (2*math.pi)
            hrp.CFrame = CFrame.new(tPos + Vector3.new(math.cos(riotAbuserOrbAng)*riotAbuse.orbitRadius, riotAbuse.orbitHeight, math.sin(riotAbuserOrbAng)*riotAbuse.orbitRadius))
        elseif riotAbuse.mode == "Phase" then
            local side = math.random(0, 1) == 0 and 1 or -1
            hrp.CFrame = CFrame.new(tPos + cf.LookVector * riotAbuse.phaseOffset + cf.RightVector * riotAbuse.right * side + cf.UpVector * (riotAbuse.height - riotAbuse.down) + rOff)
        end
        if riotAbuse.spinOnTarget then
            hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad((tick()*riotAbuse.spinSpeed) % 360), 0)
        end
        if riotAbuse.forceFaceTarget then aimAtTarget(hrp, tHrp.Position) end
        if riotAbuse.raVelZero then
            hrp.AssemblyLinearVelocity = tHrp.AssemblyLinearVelocity
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
        if riotAbuse.autoShoot then
            local now = tick()
            if (hrp.Position - tHrp.Position).Magnitude < riotAbuse.attackRange and now - riotAbuse.lastShot > riotAbuse.shootCooldown then
                riotAbuse.lastShot = now
                if riotAbuse.raAutoShootAccurate then aimAtTarget(hrp, tHrp.Position) end
                fireTool()
            end
        end
    end)
end
function stopRiotAbuser()
    if riotAbuserConn then riotAbuserConn:Disconnect(); riotAbuserConn = nil end
    riotAbuse.enabled = false
end

