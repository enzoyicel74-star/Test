local function isInsideVoidPart(pos)
    if not workspace then return false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Include
    params.FilterDescendantsInstances = { workspace }
    local result = workspace:Spherecast(pos, 1, Vector3.new(0, 0.01, 0), params)
    return result ~= nil
end

local function clampToRegion(pos)
    if not voidConf.STAY_IN_REGION then return pos end
    local cx, cy, cz = voidConf.REGION_CX, voidConf.REGION_CY, voidConf.REGION_CZ
    if voidConf.REGION_CENTER_SELF and root then cx, cy, cz = root.Position.X, root.Position.Y, root.Position.Z end
    if voidRegionCurrentRadius == nil then voidRegionCurrentRadius = math.max(voidConf.REGION_X, voidConf.REGION_Z) end
    if voidConf.REGION_COLLAPSE then voidRegionCurrentRadius = math.max(10, voidRegionCurrentRadius - voidConf.REGION_COLLAPSE_SPD * (1/60)) end
    local rx = voidConf.REGION_CIRCLE and voidRegionCurrentRadius or voidConf.REGION_X
    local ry = voidConf.REGION_Y
    local rz = voidConf.REGION_CIRCLE and voidRegionCurrentRadius or voidConf.REGION_Z
    local dx = pos.X - cx; local dy = pos.Y - cy; local dz = pos.Z - cz
    if voidConf.REGION_CIRCLE then
        local flat = math.sqrt(dx*dx + dz*dz)
        if flat > voidRegionCurrentRadius then local s = voidRegionCurrentRadius / flat; dx = dx * s; dz = dz * s end
        if voidConf.REGION_NOTIFY_EXIT and voidRegionLastIn then voidRegionLastIn = false; Notify("region: clamped back to edge", 1.5) end
        voidRegionLastIn = true
    else
        if math.abs(dx) > rx then dx = (dx > 0 and rx or -rx) end
        if math.abs(dy) > ry then dy = (dy > 0 and ry or -ry) end
        if math.abs(dz) > rz then dz = (dz > 0 and rz or -rz) end
    end
    if not voidConf.REGION_SNAP_EDGE then dx = dx + (math.random() - 0.5) * 20; dz = dz + (math.random() - 0.5) * 20 end
    return Vector3.new(cx + dx, cy + dy, cz + dz)
end

local function getTpEverywherePosition()
    local dist
    if voidConf.TP_RAND_ENABLED then dist = voidConf.TP_RAND_MIN + math.random() * (voidConf.TP_RAND_MAX - voidConf.TP_RAND_MIN)
    else dist = voidConf.TP_MIN_STUDS + math.random() * (voidConf.TP_MAX_STUDS - voidConf.TP_MIN_STUDS) end
    if voidConf.TP_NEG_BIAS and math.random() < 0.5 then dist = -math.abs(dist) end
    if not Camera or not voidConf.TP_VIEWPORT_RAY then
        return Vector3.new(voidConf.BASE_X + (math.random()*2-1)*math.abs(dist), voidConf.BASE_Y + (math.random()*2-1)*math.abs(dist), voidConf.BASE_Z + (math.random()*2-1)*math.abs(dist))
    end
    local vp = Camera.ViewportSize
    local screenX, screenY
    local roll = math.random()
    if roll < voidConf.TP_CORNER_WEIGHT then
        local corners = { Vector2.new(0,0), Vector2.new(vp.X,0), Vector2.new(0,vp.Y), Vector2.new(vp.X,vp.Y) }
        local c = corners[math.random(1, 4)]
        screenX = c.X; screenY = c.Y
    elseif roll < voidConf.TP_CORNER_WEIGHT + voidConf.TP_EDGE_WEIGHT then
        local edge = math.random(1, 4)
        if edge == 1 then screenX = math.random()*vp.X; screenY = 0
        elseif edge == 2 then screenX = math.random()*vp.X; screenY = vp.Y
        elseif edge == 3 then screenX = 0; screenY = math.random()*vp.Y
        else screenX = vp.X; screenY = math.random()*vp.Y end
    else screenX = math.random()*vp.X; screenY = math.random()*vp.Y end
    if voidConf.TP_SCREEN_JITTER > 0 then
        screenX = screenX + (math.random()-0.5)*vp.X*voidConf.TP_SCREEN_JITTER
        screenY = screenY + (math.random()-0.5)*vp.Y*voidConf.TP_SCREEN_JITTER
    end
    if voidConf.TP_SCREEN_CLAMP then screenX = math.clamp(screenX, 0, vp.X); screenY = math.clamp(screenY, 0, vp.Y) end
    local ray = Camera:ViewportPointToRay(screenX, screenY, math.abs(dist))
    local base = ray.Origin
    local vertMult = voidConf.TP_VERT_MULT_MIN + math.random() * (voidConf.TP_VERT_MULT_MAX - voidConf.TP_VERT_MULT_MIN)
    local vert = voidConf.TP_VERT_SPIKE and (math.random()*2-1)*math.abs(dist)*vertMult or 0
    if voidConf.TP_NEG_BIAS then vert = vert - math.abs(vert)*0.3 end
    if voidConf.TP_PRESERVE_Y then vert = 0 end
    local y = voidConf.TP_PRESERVE_Y and (root and root.Position.Y or 0) or (base.Y + vert)
    return Vector3.new(base.X, y, base.Z)
end

local function stepVoid(dt)
    local m = voidConf.method
    if m == "Drift" then
        voidPos = voidPos + Vector3.new(voidConf.SPEED*dt, voidConf.SPEED*dt*0.5, voidConf.SPEED*dt*0.3)
        return voidPos
    elseif m == "Chaos" then
        voidPos = voidPos + Vector3.new((math.random()-0.5)*voidConf.SPEED*dt*5, (math.random()-0.5)*voidConf.SPEED*dt*5, (math.random()-0.5)*voidConf.SPEED*dt*5)
        return voidPos
    elseif m == "Loop" then
        local r = math.min(voidConf.RADIUS*0.8, 1e9 + (voidElapsed % 100)*1e7)
        return Vector3.new(voidConf.BASE_X + math.cos(voidElapsed*2)*r, (voidConf.Y_MIN+voidConf.Y_MAX)/2 + math.sin(voidElapsed*1.3)*r*0.2, voidConf.BASE_Z + math.sin(voidElapsed*2)*r)
    elseif m == "Spiral" then
        local r = math.min(voidConf.RADIUS*0.9, (voidElapsed % 50)*2e9)
        return Vector3.new(voidConf.BASE_X + math.cos(voidElapsed*3)*r, (voidConf.Y_MIN+voidConf.Y_MAX)/2 + math.sin(voidElapsed*0.5)*r*0.3, voidConf.BASE_Z + math.sin(voidElapsed*3)*r)
    elseif m == "Quantum" then
        return Vector3.new(voidConf.BASE_X + (math.random()*2-1)*voidConf.RADIUS, (voidConf.Y_MIN+voidConf.Y_MAX)/2 + (math.random()*2-1)*(voidConf.Y_MAX-voidConf.Y_MIN)/2, voidConf.BASE_Z + (math.random()*2-1)*voidConf.RADIUS)
    elseif m == "TP Everywhere" then
        return getTpEverywherePosition()
    elseif m == "OrbitTarget" then
        local t = getClosest()
        if t and t.Character then
            local hrp = t.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local ang = voidElapsed * math.rad(voidConf.ORBIT_SPEED)
                return hrp.Position + Vector3.new(math.cos(ang)*5, 2, math.sin(ang)*5)
            end
        end
        return getTpEverywherePosition()
    end
    return voidPos
end

local function runVoidKiller(dt)
    if not voidConf.KILLER_ENABLED or not root then return end
    local myPos = root.Position
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer or not p.Character then continue end
        local hrp = p.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end
        local dist = (hrp.Position - myPos).Magnitude
        if dist > voidConf.KILLER_RANGE then continue end
        local insideVoid = isInsideVoidPart(hrp.Position)
        if insideVoid or dist < 500 then
            if voidConf.KILLER_SNAP_TO_MAP then
                local rayParams = RaycastParams.new()
                rayParams.FilterType = Enum.RaycastFilterType.Exclude
                rayParams.FilterDescendantsInstances = { LocalPlayer.Character, p.Character }
                local rayOrigin = Vector3.new(hrp.Position.X, hrp.Position.Y + 1000, hrp.Position.Z)
                local result = workspace:Raycast(rayOrigin, Vector3.new(0, -5000, 0), rayParams)
                if result then
                    pcall(function()
                        hrp.CFrame = CFrame.new(result.Position + Vector3.new(0, 3, 0))
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        hrp.AssemblyAngularVelocity = Vector3.zero
                    end)
                end
            end
            if voidConf.KILLER_FREEZE_TARGET then
                pcall(function()
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                end)
            end
            if voidConf.KILLER_FORCE_HITBOX then
                for _, part in ipairs(p.Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        pcall(function()
                            part.Size = Vector3.new(voidConf.KILLER_HITBOX_SIZE, voidConf.KILLER_HITBOX_SIZE, voidConf.KILLER_HITBOX_SIZE)
                            part.CanCollide = false; part.Massless = true
                        end)
                    end
                end
            end
            if voidConf.KILLER_NETWORK_OWN then pcall(function() hrp:SetNetworkOwner(LocalPlayer) end) end
            if voidConf.KILLER_NO_CLIP then applyNoClip(p.Character) end
            if voidConf.KILLER_AUTO_SHOOT and root then
                if voidConf.KILLER_AUTO_AIM then aimAtTarget(root, hrp.Position) end
                fireTool()
            end
            table.insert(voidKillerTargets, { player = p, time = tick() })
        end
    end
    local now = tick()
    for i = #voidKillerTargets, 1, -1 do
        if now - voidKillerTargets[i].time > 1 then table.remove(voidKillerTargets, i) end
    end
end

local function lockToVoid(dt)
    local targetPos = stepVoid(dt)
    targetPos = clampToRegion(targetPos)
    if voidConf.ANTIVOID and isInsideVoidPart(targetPos) then
        targetPos = targetPos + Vector3.new((math.random()-0.5)*200, math.random()*200, (math.random()-0.5)*200)
    end
    intendedVoidPos = targetPos
    local hrp = getLocalRoot()
    if not hrp then return end
    pcall(function()
        hrp.CFrame = CFrame.new(intendedVoidPos)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end)
    if voidConf.LOG_POSITIONS and math.random(1, 30) == 1 then print("[VOID] " .. tostring(intendedVoidPos)) end
    if math.random(1, 10) == 1 and not voidConf.ANTIFLING then
        pcall(function()
            hrp.AssemblyLinearVelocity = Vector3.new((math.random()-0.5)*2e7, (math.random()-0.5)*2e7, (math.random()-0.5)*2e7)
        end)
    end
end

