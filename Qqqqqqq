    local dir = (targetPos - myHrp.Position)
    if dir.Magnitude < 0.1 then return end
    pcall(function()
        myHrp.CFrame = CFrame.new(myHrp.Position, myHrp.Position + Vector3.new(dir.X, 0, dir.Z))
