local orbitAngle, orbitLocalElapsed, orbitCurrentRadius = 0, 0, 0
local orbitLastShot = 0
local orbitSnapTimer = 0

function startOrbit()
    killConn("orbit")
    orbitAngle = 0; orbitLocalElapsed = 0; orbitCurrentRadius = orbit.orbitDist; orbitLastShot = 0; orbitSnapTimer = 0
    if hum then pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics) end) end
    conns.orbit = RunService.Heartbeat:Connect(function(dt)
        if not orbit.orbitEnabled then killConn("orbit"); return end
        if not root then return end
        if orbit.orbitNetworkOwn then pcall(function() root:SetNetworkOwner(LocalPlayer) end) end
        if orbit.orbitNoClip and LocalPlayer.Character then applyNoClip(LocalPlayer.Character) end
        if hum then pcall(function() if hum:GetState() ~= Enum.HumanoidStateType.Physics then hum:ChangeState(Enum.HumanoidStateType.Physics) end end) end
        local target = getTarget(orbit.orbitTarget)
        local targetPos = root.Position
        local tHrp = nil
        if target and target.Character then
            tHrp = target.Character:FindFirstChild("HumanoidRootPart")
            if tHrp and (root.Position - tHrp.Position).Magnitude <= orbit.orbitLockDist then
                targetPos = tHrp.Position
                if orbit.orbitPredict then targetPos = targetPos + tHrp.AssemblyLinearVelocity * orbit.orbitPredStr end
            end
        end
        local speed = orbit.orbitReverse and -orbit.orbitSpeed or orbit.orbitSpeed
        if orbit.orbitSpeedRandom then
            speed = (orbit.orbitSpeedRandMin + math.random() * (orbit.orbitSpeedRandMax - orbit.orbitSpeedRandMin))
            if orbit.orbitReverse then speed = -speed end
        end
        orbitAngle = (orbitAngle + math.rad(speed) * dt) % (2 * math.pi)
        orbitLocalElapsed = orbitLocalElapsed + dt
        local r = orbit.orbitRandRad and math.random(orbit.orbitRandMin, orbit.orbitRandMax) or orbit.orbitDist
        if orbit.orbitDistPulse then r = r + math.sin(orbitLocalElapsed * orbit.orbitDistPulseSpeed * 2 * math.pi) * orbit.orbitDistPulseAmp end
        local h = orbit.orbitHeight
        if orbit.orbitHeightOscillate then h = h + math.sin(orbitLocalElapsed * orbit.orbitHeightOscSpeed * 2 * math.pi) * orbit.orbitHeightOscAmp end
        local x, y, z = 0, 0, 0
        local ax = orbit.orbitAxis
        if orbit.orbitMode == "Circle" then
            if ax == "XZ" then x = math.cos(orbitAngle)*r; z = math.sin(orbitAngle)*r; y = h
            elseif ax == "XY" then x = math.cos(orbitAngle)*r; y = math.sin(orbitAngle)*r; z = h
            elseif ax == "YZ" then y = math.cos(orbitAngle)*r; z = math.sin(orbitAngle)*r; x = h end
        elseif orbit.orbitMode == "Figure 8" then
            x = math.sin(orbitAngle)*r; z = math.sin(orbitAngle)*math.cos(orbitAngle)*r*0.7; y = h
        elseif orbit.orbitMode == "Ellipse" then
            x = math.cos(orbitAngle)*r; z = math.sin(orbitAngle)*r*0.6; y = h
        elseif orbit.orbitMode == "Spiral In" then
            orbitCurrentRadius = math.max(1, orbitCurrentRadius - dt * orbit.orbitDist * 0.2)
            x = math.cos(orbitAngle)*orbitCurrentRadius; z = math.sin(orbitAngle)*orbitCurrentRadius; y = h
        elseif orbit.orbitMode == "Spiral Out" then
            orbitCurrentRadius = math.min(orbit.orbitDist*2, orbitCurrentRadius + dt * orbit.orbitDist * 0.2)
            x = math.cos(orbitAngle)*orbitCurrentRadius; z = math.sin(orbitAngle)*orbitCurrentRadius; y = h
        elseif orbit.orbitMode == "Bounce" then
            x = math.cos(orbitAngle)*r; z = math.sin(orbitAngle)*r; y = h + math.sin(orbitLocalElapsed*3)*5
        elseif orbit.orbitMode == "Lemniscate" then
            local denom = 1 + math.sin(orbitAngle)^2
            x = r*math.cos(orbitAngle)/denom; z = r*math.sin(orbitAngle)*math.cos(orbitAngle)/denom; y = h
        elseif orbit.orbitMode == "Infinity" then
            x = r*math.cos(orbitAngle); z = r*math.sin(2*orbitAngle)/2; y = h
        elseif orbit.orbitMode == "RandomOrbit" then
            local a = math.random()*2*math.pi; x = math.cos(a)*r; z = math.sin(a)*r; y = h
        end
        if orbit.orbitZigzag then x = x + math.sin(orbitLocalElapsed * orbit.orbitZigzagFreq * 2 * math.pi) * orbit.orbitZigzagAmp end
        x = x + orbit.orbitOffX; z = z + orbit.orbitOffZ
        local dst = targetPos + Vector3.new(x, y, z)
        if orbit.orbitSnapBack then
            orbitSnapTimer = orbitSnapTimer + dt
            if orbitSnapTimer >= orbit.orbitSnapInterval then
                orbitSnapTimer = 0
                dst = targetPos + Vector3.new(orbit.orbitOffX, h, orbit.orbitOffZ)
            end
        end
        local alpha = math.min(1, 1 - (1 - orbit.orbitLerp)^(dt * 60))
        local smooth = root.Position:Lerp(dst, alpha)
        pcall(function()
            if orbit.orbitFace then
                local cf = CFrame.new(smooth, Vector3.new(targetPos.X, smooth.Y, targetPos.Z))
                cf = cf * CFrame.Angles(math.rad(orbit.orbitPitchOff), math.rad(orbit.orbitYawOff), 0)
                root.CFrame = cf
            else
                root.CFrame = CFrame.new(smooth)
            end
            if orbit.orbitVelZero then root.AssemblyLinearVelocity = Vector3.zero; root.AssemblyAngularVelocity = Vector3.zero end
        end)
        if orbit.orbitAutoShoot and tHrp and target then
            local now = tick()
            if (root.Position - tHrp.Position).Magnitude < orbit.orbitAttackRange and now - orbitLastShot > orbit.orbitShootCooldown then
                orbitLastShot = now
                if orbit.orbitAutoAim then aimAtTarget(root, tHrp.Position) end
                fireTool()
            end
        end
    end)
end
function stopOrbit()
    killConn("orbit"); orbit.orbitEnabled = false
    if hum then pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end) end
end

