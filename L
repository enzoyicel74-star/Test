                            if aim_part and camera then
                                local old_cf = camera.CFrame
                                camera.CFrame = CFrame.lookAt(camera.CFrame.Position, aim_part.Position)
                                local shoot_result = {old(controller, is_empty, debounce)}
                                camera.CFrame = old_cf
                                if client_fighter.EquippedItem and ELI.guns.no_spread then shoot_result[4] = true end
                                if ELI.visuals.hit_notify.enable or ELI.visuals.hitsound.enable or ELI.visuals.damage_numbers.enable then
