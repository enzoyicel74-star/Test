        function Spoofer.CreateBinder(instance, attribute)
            local binder = {
                Instance = instance,
                Attribute = attribute,
                Original = instance:GetAttribute(attribute),
                IsWriting = false,
                Spoofed = nil,
                Connection = nil,
            }
            binder.Connection = instance:GetAttributeChangedSignal(attribute):Connect(function()
                if binder.IsWriting then return end
                binder.Original = instance:GetAttribute(attribute)
                binder.IsWriting = true
                if binder.Spoofed ~= nil then
                    instance:SetAttribute(attribute, binder.Spoofed.value)
                end
                binder.IsWriting = false
            end)
            return binder
        end

        function Spoofer.BinderSet(binder, spoofed)
            binder.Spoofed = spoofed
            binder.IsWriting = true
            if spoofed == nil then
                binder.Instance:SetAttribute(binder.Attribute, binder.Original)
            else
                binder.Instance:SetAttribute(binder.Attribute, spoofed.value)
            end
            binder.IsWriting = false
        end

        function Spoofer.BinderDestroy(binder)
            if binder.Connection then binder.Connection:Disconnect() end
            pcall(function()
                binder.Instance:SetAttribute(binder.Attribute, binder.Original)
            end)
        end

        function Spoofer.Bind(player, attribute)
            local entries = Spoofer.Binders[player]
            if entries == nil then
                entries = {}
                Spoofer.Binders[player] = entries
            end
            local binder = entries[attribute]
            if binder == nil then
                binder = Spoofer.CreateBinder(player, attribute)
                entries[attribute] = binder
            end
            return binder
        end

        function Spoofer.Unbind(player, attribute)
            local entries = Spoofer.Binders[player]
            if entries == nil then return end
            local binder = entries[attribute]
            if binder ~= nil then
                Spoofer.BinderDestroy(binder)
                entries[attribute] = nil
            end
        end

        function Spoofer.SetSpoof(player, attribute, enabled, value)
            if enabled then
                Spoofer.BinderSet(Spoofer.Bind(player, attribute), { value = value })
            else
                Spoofer.Unbind(player, attribute)
            end
        end

        function Spoofer.ScopeKey(player)
            return player == LocalPlayer and "you" or "others"
        end

        function Spoofer.Apply(player)
            if not player or player.Parent == nil then return end
            local scope = Spoofer.ScopeKey(player)
            local cfg = ELI.misc.spoofer[scope]
            if not cfg then return end

            for _, field in ipairs(Spoofer.Fields) do
                local enabled = cfg.enabled and cfg.values[field.key .. "_on"] == true
                if field.fixed then
                    Spoofer.SetSpoof(player, field.attribute, enabled, field.constValue)
                else
                    local raw = cfg.values[field.key]
                    local value = raw
                    if field.control == "number" then
                        value = tonumber(raw)
                    elseif type(raw) == "string" and raw == "" then
                        value = nil
                    end
                    Spoofer.SetSpoof(player, field.attribute, enabled and value ~= nil, value)
                end
            end
        end

        function Spoofer.Cleanup(player)
            local entries = Spoofer.Binders[player]
            if entries == nil then return end
            for _, binder in pairs(entries) do
                Spoofer.BinderDestroy(binder)
            end
            Spoofer.Binders[player] = nil
        end

        function Spoofer.Refresh()
            Spoofer.Start()
            for _, player in ipairs(Players:GetPlayers()) do
                Spoofer.Apply(player)
            end
        end

        function Spoofer.Start()
            if Spoofer.Started then return end
            Spoofer.Started = true
            table.insert(Spoofer.Connections, Players.PlayerAdded:Connect(function(player)
                Spoofer.Apply(player)
            end))
            table.insert(Spoofer.Connections, Players.PlayerRemoving:Connect(function(player)
                Spoofer.Cleanup(player)
            end))
        end

        function Spoofer.Destroy()
            for _, connection in ipairs(Spoofer.Connections) do
                pcall(function() connection:Disconnect() end)
            end
            Spoofer.Connections = {}
            Spoofer.Started = false
            for player in pairs(Spoofer.Binders) do
