                afov_c_rad = afov_c_rad + (ELI.aimbot.fov_radius - afov_c_rad) * at

                sfov.Visible = s_show
                sfov.BackgroundColor3 = ELI.silent_aim.fov_fill_color
                sfov.BackgroundTransparency = ELI.silent_aim.show_fill and ELI.silent_aim.fov_fill_transparency or 1
                sfov.Size = UDim2.new(0, sfov_c_rad * 2, 0, sfov_c_rad * 2)
                sfov.Position = UDim2.new(0, sfov_c_pos.X - sfov_c_rad, 0, sfov_c_pos.Y - sfov_c_rad)
                sfov.Rotation = sfov_rot
                sfov_stroke.Color = ELI.silent_aim.fov_color
                sfov_stroke.Transparency = math.clamp(ELI.silent_aim.fov_outline_transparency, 0, 1)
                sfov_stroke.Thickness = ELI.silent_aim.fov_thickness
                sfov_fill_gradient.Enabled = ELI.silent_aim.show_fill
                sfov_fill_gradient.Color = ColorSequence.new({ColorSequenceKeypoint.new(0, ELI.silent_aim.fov_fill_color), ColorSequenceKeypoint.new(1, ELI.silent_aim.fov_fill_color2)})
                sfov_fill_gradient.Rotation = sfov_rot
                sfov_stroke_gradient.Color = ColorSequence.new({ColorSequenceKeypoint.new(0, ELI.silent_aim.fov_color), ColorSequenceKeypoint.new(1, ELI.silent_aim.fov_color2 or ELI.silent_aim.fov_color)})
                sfov_stroke_gradient.Rotation = sfov_rot

                afov.Visible = a_show
                afov.BackgroundColor3 = ELI.aimbot.fov_fill_color
                afov.BackgroundTransparency = ELI.aimbot.show_fill and ELI.aimbot.fov_fill_transparency or 1
                afov.Size = UDim2.new(0, afov_c_rad * 2, 0, afov_c_rad * 2)
                afov.Position = UDim2.new(0, afov_c_pos.X - afov_c_rad, 0, afov_c_pos.Y - afov_c_rad)
                afov.Rotation = afov_rot
                afov_stroke.Color = ELI.aimbot.fov_color
                afov_stroke.Transparency = math.clamp(ELI.aimbot.fov_outline_transparency, 0, 1)
                afov_stroke.Thickness = ELI.aimbot.fov_thickness
                afov_fill_gradient.Enabled = ELI.aimbot.show_fill
