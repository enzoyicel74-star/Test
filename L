        local function buildSpooferGroup(scopeKey, groupTitle, side)
            local cfg = ELI.misc.spoofer[scopeKey]
            local group = side == "left"
                and Tabs.Misc:AddLeftGroupbox(groupTitle)
                or Tabs.Misc:AddRightGroupbox(groupTitle)

            group:AddToggle("Spoofer_" .. scopeKey .. "_Master", {
                Text = "Enabled",
                Default = false,
                Callback = function(v)
                    cfg.enabled = v
                    Spoofer.Refresh()
                end,
            })

            for _, field in ipairs(spooferFields) do
                group:AddToggle("Spoofer_" .. scopeKey .. "_" .. field.key .. "_T", {
                    Text = field.label,
                    Default = false,
                    Callback = function(v)
                        cfg.values[field.key .. "_on"] = v
                        Spoofer.Refresh()
                    end,
                })
                if field.ctrl == "number" then
                    group:AddSlider("Spoofer_" .. scopeKey .. "_" .. field.key .. "_V", {
                        Text = "  value",
                        Default = tonumber(cfg.values[field.key]) or 0,
                        Min = 0, Max = 9999, Rounding = 0,
                        Callback = function(v)
                            cfg.values[field.key] = tostring(math.floor(v))
                            Spoofer.Refresh()
                        end,
                    })
                elseif field.ctrl == "text" then
                    group:AddInput("Spoofer_" .. scopeKey .. "_" .. field.key .. "_V", {
                        Text = "  value",
                        Default = cfg.values[field.key] or "",
                        Placeholder = "text",
                        Callback = function(v)
                            cfg.values[field.key] = v or ""
                            Spoofer.Refresh()
                        end,
                    })
                end
            end
        end

