                local show = tj.all_weapons or (name and throwables[string.lower(name)])
                if show then
                    local origin = camera.CFrame.Position
                    local vel = camera.CFrame.LookVector * tj.speed + Vector3.new(0, tj.arc_up, 0)
                    local grav = Vector3.new(0, -workspace.Gravity, 0)
                    local params = RaycastParams.new()
                    params.FilterType = Enum.RaycastFilterType.Exclude
                    params.FilterDescendantsInstances = { LocalPlayer.Character, traj_folder }
                    local points = { origin }
                    local pos = origin; local v = vel
                    for _ = 1, 30 do
                        local nextPos = pos + v * 0.07 + grav * (0.5 * 0.07 * 0.07)
                        local hit = workspace:Raycast(pos, nextPos - pos, params)
                        if hit then points[#points + 1] = hit.Position; break end
                        points[#points + 1] = nextPos
                        pos = nextPos; v = v + grav * 0.07
                    end
                    for i = 1, #points do
                        local p = traj_getpart(i)
                        p.Position = points[i]; p.Color = tj.color; p.Transparency = 0
                    end
                    for i = #points + 1, #traj_pool do if traj_pool[i] then traj_pool[i].Transparency = 1 end end
                else
                    for i = 1, #traj_pool do if traj_pool[i] then traj_pool[i].Transparency = 1 end end
                end
