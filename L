                        if ELI.antiaim.enable then
                            if Self.IsSliding or (Self.IsAlive and not Self:IsAlive()) then
                                return antiaim_original.update_rotation(Self, ...)
                            end
                            local Entity = Self.LocalFighter and Self.LocalFighter.Entity
                            if not Entity then return antiaim_original.update_rotation(Self, ...) end
                            local RootPart = Entity.RootPart
                            local Humanoid = Entity.Humanoid
                            if not RootPart or not Humanoid then return antiaim_original.update_rotation(Self, ...) end
                            Humanoid.AutoRotate = true
                            pcall(function()
                                RootPart.CFrame = RootPart.CFrame * CFrame.Angles(0, math.rad(antiaim_root_angle), 0)
                            end)
                            antiaim_root_angle = (antiaim_root_angle + ELI.antiaim.speed) % 360
                            return
                        end
                        return antiaim_original.update_rotation(Self, ...)
                    end
                end)
            end
            if utility and utility.EncodeCameraRotation then
                pcall(function()
                    antiaim_original.encode_camera = utility.EncodeCameraRotation
                    utility.EncodeCameraRotation = function(Self, Rotation, ...)
                        if ELI.antiaim.enable then
