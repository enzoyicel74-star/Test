        local function try_load_emote(animator, id)
            local anim
            local okObjects, objects = pcall(function() return game:GetObjects("rbxassetid://" .. id) end)
            if okObjects and objects and objects[1] and objects[1]:IsA("Animation") then anim = objects[1]
            else anim = Instance.new("Animation"); anim.AnimationId = "rbxassetid://" .. id end
            local okLoad, track = pcall(function() return animator:LoadAnimation(anim) end)
            if not okLoad or not track then return nil end
            local okPlay = pcall(function() track.Priority = Enum.AnimationPriority.Action4; track.Looped = true; track:Play() end)
            if not okPlay then pcall(function() track:Stop() end); return nil end
            task.wait(0.15)
