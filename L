                    local rad = math.rad(ch_angle)
                    local c, s = math.cos(rad), math.sin(rad)
                    local vp = camera.ViewportSize
                    local cx, cy = vp.X / 2, vp.Y / 2
                    local arms = {
                        { Vector2.new(0, -ch.gap), Vector2.new(0, -ch.gap - ch.length), ch.top_line },
                        { Vector2.new(0, ch.gap), Vector2.new(0, ch.gap + ch.length), ch.bottom_line },
                        { Vector2.new(-ch.gap, 0), Vector2.new(-ch.gap - ch.length, 0), ch.left_line },
                        { Vector2.new(ch.gap, 0), Vector2.new(ch.gap + ch.length, 0), ch.right_line },
                    }
                    for i = 1, 4 do
                        local arm = arms[i]; local l = ch_lines[i]
                        if arm[3] then
                            local from, to = arm[1], arm[2]
                            local fr = Vector2.new(from.X * c - from.Y * s, from.X * s + from.Y * c)
                            local tr = Vector2.new(to.X * c - to.Y * s, to.X * s + to.Y * c)
                            local f = Vector2.new(cx + fr.X, cy + fr.Y)
                            local t = Vector2.new(cx + tr.X, cy + tr.Y)
                            local len = (t - f).Magnitude
                            if len > 0.1 then
                                local mid = (f + t) / 2
                                l.Position = UDim2.fromOffset(mid.X, mid.Y)
                                l.Size = UDim2.fromOffset(ch.thickness, len)
                                l.Rotation = math.deg(math.atan2(t.X - f.X, -(t.Y - f.Y)))
                                l.BackgroundColor3 = ch.color
                                l.Visible = true
                            else l.Visible = false end
                        else l.Visible = false end
                    end
                    if ch.dot then ch_dot.Visible = true; ch_dot.BackgroundColor3 = ch.color; ch_dot.Position = UDim2.fromOffset(cx, cy) else ch_dot.Visible = false end
                end
            elseif ch_gui and (ch_lines[1].Visible or ch_dot.Visible) then
