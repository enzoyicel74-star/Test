            return track
        end

        local function emote_tick()
            local cfg = ELI.character.emote
            if not cfg.enable then if emote_playing then emote_stop() end return end
            local char = LocalPlayer.Character
            if not char then emote_stop(); return end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hum then emote_stop(); return end
            local animator = hum:FindFirstChildOfClass("Animator")
            if not animator then emote_stop(); return end
            if emote_playing and not emote_playing.IsPlaying then emote_playing = nil; emote_last_id = "" end
            local selected = cfg.custom_id ~= "" and cfg.custom_id or emotes[cfg.selected]
            if not selected or selected == "" then return end
            if selected ~= emote_last_id then
                if emote_playing then pcall(function() emote_playing:Stop() end); emote_playing = nil end
                emote_last_id = selected
                local track = try_load_emote(animator, clean_id(selected))
                if not track and not emote_fallback_used then
                    emote_fallback_used = true
                    for name, id in pairs(game_animations) do
                        local fid = clean_id(id)
