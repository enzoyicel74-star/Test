        local function check_wall(part)
            if not part then return false end
            local origin = camera.CFrame.Position
            local dir = part.Position - origin
            local ray = Ray.new(origin, dir)
            local hit = workspace:FindPartOnRayWithIgnoreList(ray, {LocalPlayer.Character, part.Parent})
            return not hit
        end

        local function is_on_screen(world_pos)
            local sp, on = camera:WorldToViewportPoint(world_pos)
            if not on then return false end
            if sp.Z <= 0 then return false end
            local vp = camera.ViewportSize
            if sp.X < 0 or sp.X > vp.X or sp.Y < 0 or sp.Y > vp.Y then return false end
            return true, Vector2.new(sp.X, sp.Y)
        end

        local function getclosest(fov, wall_check)
            local closest = ELI.targeting.max_distance
            local player
            local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
            for _, v in Players:GetPlayers() do
                if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild(ELI.targeting.part) then
                    local hum = v.Character:FindFirstChildOfClass("Humanoid")
                    if not hum or hum.Health <= 0 then continue end
                    if is_deflecting(v) then continue end
                    if v:GetAttribute('TeamID') == LocalPlayer:GetAttribute('TeamID') then continue end
                    if ELI.targeting.visible_only and not check_wall(v.Character[ELI.targeting.part]) then continue end
                    if ELI.silent_aim.riot_shield and has_riot(v) then continue end

                    local target_part = v.Character[ELI.targeting.part]
                    local target_pos = target_part.Position

                    local on_screen, screen_pos = is_on_screen(target_pos)
                    if not on_screen then continue end

                    local d = (center - screen_pos).Magnitude
                    if d >= closest or d > fov then continue end

                    if wall_check then
                        if not check_wall(target_part) then continue end
                    end

                    player = v
                    closest = d
                end
            end
            return player
        end

