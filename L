                if not mblur_accum then mblur_accum = 0; mblur_lastlook = camera.CFrame.LookVector end
                mblur_accum += dt
                if mblur_accum >= 1/60 then
                    local real_dt = mblur_accum; mblur_accum = 0
                    mblur.Enabled = true
                    local look = camera.CFrame.LookVector
                    local delta = (look - mblur_lastlook).Magnitude
                    mblur_lastlook = look
                    local target = math.clamp(delta / math.max(real_dt, 1/240) * mbc.sensitivity * mbc.intensity * 0.35, 0, 56 * mbc.intensity)
                    mblur.Size = mblur.Size + (target - mblur.Size) * math.min(real_dt * 20, 1)
                end
