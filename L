        local function installAntiAim()
            if antiaim_original then return end
            antiaim_original = {}
            if mechanics_controller and mechanics_controller._UpdateCharacterRotation then
                pcall(function()
                    antiaim_original.update_rotation = mechanics_controller._UpdateCharacterRotation
