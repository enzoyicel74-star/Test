local function safeCall(fn, ...)
    local ok, err = pcall(fn, ...)
    if not ok then
        warn("[mind] error:", err)
    end
    return ok
end

local function safeSet(instance, prop, value)
    if not instance then return end
    pcall(function() instance[prop] = value end)
end

